<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <AssemblyName>LessRestrictingHeadwear</AssemblyName>
    <RootNamespace>LessRestrictingHeadwear</RootNamespace>
    <Version>4.0.0</Version>
    <Authors>MusicManiac</Authors>
    <Company>MusicManiac</Company>
    <Copyright>Copyright (c) 2023-2026 MusicManiac</Copyright>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SptPath Condition="'$(SptPath)' == ''">$(MSBuildThisFileDirectory)..\..\SPT_Runtime</SptPath>
    <OutputPath>$(MSBuildThisFileDirectory)dist\LessRestrictingHeadwear\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptPath)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptPath)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptPath)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptPath)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config.jsonc" CopyToOutputDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
